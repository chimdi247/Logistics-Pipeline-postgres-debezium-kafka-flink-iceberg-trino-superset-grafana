[Unit]
Description=AtlasFlow data platform (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__ROOT_DIR__
# `up -d` re-runs the idempotent pipeline-bootstrap service, which resubmits the Flink jobs that a
# reboot (or JobManager restart) discards. Containers themselves also use restart: unless-stopped.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=1800
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
