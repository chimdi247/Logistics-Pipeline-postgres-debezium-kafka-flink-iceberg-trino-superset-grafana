# AtlasFlow local/VM configuration. Copy to .env (or run ./scripts/prepare-local-env.sh, which
# generates strong secrets for every change_this_* value). Never commit .env.

# --- Network exposure -------------------------------------------------------------------------
# Interface the published ports bind to. Keep 127.0.0.1 on a cloud VM and use SSH tunnels.
# Only set 0.0.0.0 if the VM firewall / security group restricts access to trusted IPs.
BIND_ADDRESS=127.0.0.1
# Hostname Kafka advertises to clients running outside Docker (on the VM itself: localhost).
KAFKA_ADVERTISED_HOST=localhost
# Public URL of Grafana (used in links/alerts). Behind an SSH tunnel keep the default.
GRAFANA_ROOT_URL=http://localhost:3000/

# --- PostgreSQL (operational source) ----------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
POSTGRES_PORT=55432
CDC_PASSWORD=change_this_cdc_password
# Read-only (pg_monitor) role used by postgres-exporter; letters, digits, _ and - only.
POSTGRES_EXPORTER_PASSWORD=change_this_exporter_password

# --- Object storage (RustFS, S3-compatible). 8-80 chars: letters, digits, _ and - only. -------
RUSTFS_ACCESS_KEY=change_this_rustfs_access_key
RUSTFS_SECRET_KEY=change_this_rustfs_secret_key

# --- Superset ---------------------------------------------------------------------------------
SUPERSET_DB_PASSWORD=change_this_superset_db_password
SUPERSET_SECRET_KEY=change_this_superset_secret_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=password
SUPERSET_ADMIN_EMAIL=atlasadmin@local.com

# --- Grafana ----------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# --- Synthetic data generator (runs as the data-generator service) ----------------------------
# Set GENERATOR_ENABLED=false to idle the generator and drive PostgreSQL with your own writes.
GENERATOR_ENABLED=true
GENERATOR_BATCH_COUNT=4
GENERATOR_INTERVAL_SECONDS=30
